# Copy to .env (docker compose reads it) or export these for local dev.
DATABASE_URL=postgresql+asyncpg://matcher:matcher@localhost:5432/matcher
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-string
# minilm = sentence-transformers/all-MiniLM-L6-v2 (needs backend/requirements-ml.txt), hash = no-download fallback
EMBEDDER=minilm
# arq = Redis worker (docker compose), inline = parse inside the API process
QUEUE=arq
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000
